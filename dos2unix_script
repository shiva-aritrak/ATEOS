#!/bin/bash

# Check if a directory was provided as an argument
if [ -z "$1" ]; then
  echo "Usage: $0 <directory>"
  exit 1
fi

DIRECTORY=$1

# Function to recursively apply dos2unix
convert_files() {
  local DIR=$1
  for file in "$DIR"/*; do
    if [ -d "$file" ]; then
      convert_files "$file"
    elif [ -f "$file" ]; then
      # Move the cursor to the beginning of the line and clear it
      tput cr
      tput el
      echo -n "Converting $file"
      dos2unix "$file"
    fi
  done
}

# Clear the screen and hide the cursor
tput clear
tput civis

# Start the conversion
convert_files "$DIRECTORY"

# Move to the next line after all files are processed
echo
# Show the cursor
tput cnorm

