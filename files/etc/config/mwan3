config globals 'globals'
	option mmx_mask '0x3F00'

config interface 'wan'
	option enabled '1'
	list track_ip '8.8.8.8'
	list track_ip '4.4.4.4'
	list track_ip '1.1.1.1'
	option family 'ipv4'
	option reliability '2'

config interface 'wan2'
	option enabled '0'
	list track_ip '8.8.8.8'
	list track_ip '4.4.4.4'
	list track_ip '1.1.1.1'
	option family 'ipv4'
	option reliability '1'

config interface 'cellular'
	option enabled '1'
	list track_ip '8.8.8.8'
	list track_ip '1.1.1.1'
	list track_ip '1.1.1.1'
	option family 'ipv4'
	option reliability '1'

config member 'wan_m1_w3'
	option interface 'wan'
	option metric '1'
	option weight '3'

config member 'wan_m2_w3'
	option interface 'wan'
	option metric '2'
	option weight '3'

config member 'wan2_m1_w2'
	option interface 'wan2'
	option metric '1'
	option weight '2'

config member 'wan2_m1_w3'
	option interface 'wan2'
	option metric '1'
	option weight '3'

config member 'wan2_m2_w2'
	option interface 'wan2'
	option metric '2'
	option weight '2'

config member 'cellular_m1_w2'
	option interface 'cellular'
	option metric '1'
	option weight '2'

config member 'cellular_m2_w2'
	option interface 'cellular'
	option metric '2'
	option weight '2'

config member 'cellular_m3_w1'
	option interface 'cellular'
	option metric '3'
	option weight '1'

config policy 'wan_only'
	list use_member 'wan_m1_w3'

config policy 'wan2_only'
	list use_member 'wan2_m1_w2'

config policy 'cellular_only'
	list use_member 'cellular_m1_w2'

config policy 'balanced'
	list use_member 'wan_m1_w3'
	list use_member 'wan2_m1_w3'
	list use_member 'cellular_m1_w2'

config policy 'wan_wan2'
	list use_member 'wan_m1_w3'
	list use_member 'wan2_m2_w2'

config policy 'wan2_wan'
	list use_member 'wan_m2_w3'
	list use_member 'wan2_m1_w2'

config policy 'wan_wan2_cellular'
	list use_member 'wan_m1_w3'
	list use_member 'wan2_m2_w2'
	list use_member 'cellular_m3_w1'

config policy 'wan2_wan_cellular'
	list use_member 'wan_m2_w3'
	list use_member 'wan2_m1_w2'
	list use_member 'cellular_m3_w1'

config policy 'cellular_backup'
	list use_member 'wan_m1_w3'
	list use_member 'wan2_m2_w2'
	list use_member 'cellular_m3_w1'

config rule 'https'
	option sticky '1'
	option dest_port '443'
	option proto 'tcp'
	option use_policy 'cellular_backup'

config rule 'default_rule_v4'
	option dest_ip '0.0.0.0/0'
	option use_policy 'cellular_backup'
	option family 'ipv4'
