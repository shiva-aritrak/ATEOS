
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid 'auto'
	option ula_prefix 'auto'
	option packet_steering '1'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0.1'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.26.1/24'
	option ip6assign '60'

# WAN MAC addresses are filled in per device from the factory partition
# by /etc/uci-defaults/98-ace-wan-macaddr.
config device 'wan_dev'
	option name 'eth0.2'

config device 'wan2_dev'
	option name 'eth0.3'

config interface 'wan'
	option device 'eth0.2'
	option proto 'dhcp'

config interface 'wan6'
	option device 'eth0.2'
	option proto 'dhcpv6'
	option reqaddress 'try'
	option reqprefix 'auto'
	option norelease '1'
	option multipath 'off'

config interface 'wan2'
	option device 'eth0.3'
	option proto 'dhcp'
	option multipath 'off'

config interface 'wan26'
	option device 'eth0.3'
	option proto 'dhcpv6'
	option reqaddress 'try'
	option reqprefix 'auto'
	option norelease '1'
	option multipath 'off'

config switch
	option name 'switch0'
	option reset '1'
	option enable_vlan '1'

# LAN: ports 1 2 3, WAN: port 4, WAN2: port 0, CPU: 6 (tagged)
config switch_vlan
	option device 'switch0'
	option vlan '1'
	option ports '6t 1 2 3'
	option vid '1'

config switch_vlan
	option device 'switch0'
	option vlan '2'
	option ports '6t 4'
	option vid '2'

config switch_vlan
	option device 'switch0'
	option vlan '3'
	option ports '6t 0'
	option vid '3'
