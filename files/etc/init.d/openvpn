#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1

start_instance() {
    local section="$1"
    local enabled config

    config_get_bool enabled "$section" enabled 1

    # Only enforce enabled when starting all instances at boot/service start.
    if [ "$START_ALL" = "1" ]; then
        [ "$enabled" = "1" ] || return 0
    fi

    config_get config "$section" config
    [ -f "$config" ] || {
        logger -t openvpn "Config not found for $section: $config"
        return 1
    }

    procd_open_instance "$section"
    procd_set_param command /usr/sbin/openvpn --config "$config"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

start_service() {
    config_load openvpn

    if [ -n "$1" ]; then
        start_instance "$1"
    else
        START_ALL=1
        config_foreach start_instance openvpn
    fi
}

stop_service() {
    if [ -n "$1" ]; then
        procd_kill openvpn "$1"
    else
        procd_kill openvpn
    fi
}
