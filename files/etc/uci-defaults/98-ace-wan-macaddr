#!/bin/sh

# Give WAN (eth0.2) and WAN2 (eth0.3) unique MACs per device, derived from
# the factory MAC like the stock board defaults: WAN = base+1, WAN2 = base+2.

. /lib/functions/system.sh

base="$(mtd_get_mac_binary factory 0x4)"
[ -n "$base" ] || exit 0

[ -z "$(uci -q get network.wan_dev.macaddr)" ] && \
	uci -q set network.wan_dev.macaddr="$(macaddr_add "$base" 1)"
[ -z "$(uci -q get network.wan2_dev.macaddr)" ] && \
	uci -q set network.wan2_dev.macaddr="$(macaddr_add "$base" 2)"
uci -q commit network

exit 0
