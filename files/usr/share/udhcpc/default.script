#!/bin/sh

IGNORE_IFACES="loopback lan"

is_ignored_iface() {
	local name="$1"

	for x in $IGNORE_IFACES; do
		[ "$name" = "$x" ] && return 0
	done

	return 1
}

get_logical_iface() {
	local iface dev

	for iface in $(uci show network | grep "=interface" | cut -d. -f2 | cut -d= -f1); do
		is_ignored_iface "$iface" && continue

		dev="$(uci -q get network.$iface.device)"
		[ -z "$dev" ] && dev="$(uci -q get network.$iface.ifname)"

		[ "$dev" = "$interface" ] && {
			echo "$iface"
			return 0
		}
	done

	return 1
}

get_metric() {
	local logical metric

	logical="$(get_logical_iface)"

	if [ -n "$logical" ]; then
		metric="$(uci -q get network.$logical.metric)"
		[ -n "$metric" ] && {
			echo "$metric"
			return
		}
	fi

	echo 100
}

set_classless_routes() {
	local max=128
	local type

	while [ -n "$1" ] && [ -n "$2" ] && [ "$max" -gt 0 ]; do
		[ "${1##*/}" = "32" ] && type=host || type=net

		echo "udhcpc: adding route for $type $1 via $2 dev $interface"
		ip route replace "$1" via "$2" dev "$interface"

		max=$((max - 1))
		shift 2
	done
}

setup_interface() {
	local METRIC logical

	logical="$(get_logical_iface)"
	METRIC="$(get_metric)"

	echo "udhcpc: interface=$interface logical=${logical:-unknown} metric=$METRIC"

	ip -4 addr flush dev "$interface"

	echo "udhcpc: adding $ip/${subnet:-255.255.255.0} dev $interface"
	ip addr add "$ip/${subnet:-255.255.255.0}" broadcast "${broadcast:-+}" dev "$interface"

	if [ -n "$router" ] && [ "$router" != "0.0.0.0" ] && [ "$router" != "255.255.255.255" ]; then
		for gw in $router; do
			echo "udhcpc: default route via $gw dev $interface metric $METRIC"
			ip route replace default via "$gw" dev "$interface" metric "$METRIC"
		done
	fi

	[ -n "$staticroutes" ] && set_classless_routes $staticroutes
	[ -n "$msstaticroutes" ] && set_classless_routes $msstaticroutes
}

[ -z "$1" ] && {
	echo "Error: should be run by udhcpc"
	exit 1
}

case "$1" in
	deconfig)
		echo "udhcpc: deconfig $interface"
		ip -4 addr flush dev "$interface"
		ip route flush dev "$interface"
		;;

	renew)
		echo "udhcpc: renew $interface"
		setup_interface
		;;

	bound)
		echo "udhcpc: bound $interface"
		setup_interface
		;;
esac

[ -f /etc/udhcpc.user ] && . /etc/udhcpc.user

exit 0
