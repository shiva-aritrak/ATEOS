config globals 'globals'
        option mmx_mask '0x3F00'

config interface 'wan'
        option enabled '1'
        list track_ip '8.8.8.8'
        option family 'ipv4'
        option reliability '1'
        option count '1'
        option timeout '1'
        option interval '2'
        option failure_interval '1'
        option down '2'
        option up '3'
        option recovery_interval '2'
        option initial_state 'online'
        option track_method 'ping'

config interface 'wan2'
        option enabled '1'
        list track_ip '8.8.8.8'
        option family 'ipv4'
        option reliability '1'
        option initial_state 'online'
        option track_method 'ping'
        option count '1'
        option size '56'
        option max_ttl '60'
        option timeout '1'
        option interval '2'
        option failure_interval '1'
        option recovery_interval '2'
        option down '2'
        option up '3'

config interface 'cellular'
        option enabled '1'
        list track_ip '8.8.8.8'
        option family 'ipv4'
        option reliability '1'
        option count '1'
        option timeout '2'
        option interval '3'
        option failure_interval '2'
        option down '2'
        option up '3'
        option recovery_interval '3'


config member 'wan2_m1_w2'
        option interface 'wan2'
        option metric '1'
        option weight '2'

config member 'wan2_m1_w3'
        option interface 'wan2'
        option metric '1'
        option weight '3'

config member 'wan2_m2_w2'
        option interface 'wan2'
        option metric '2'
        option weight '2'

config member 'cellular_m1_w2'
        option interface 'cellular'
        option metric '1'
        option weight '2'

config member 'cellular_m2_w2'
        option interface 'cellular'
        option metric '2'
        option weight '2'

config member 'cellular_m3_w1'
        option interface 'cellular'
        option metric '3'
        option weight '1'

config rule 'default_rule_v4'
        option dest_ip '0.0.0.0/0'
        option use_policy 'cell_backup'
        option proto 'all'
        option sticky '0'
        option logging '0'

config member 'lb_wan'
        option interface 'wan'
        option metric '1'
        option weight '1'

config member 'lb_cell'
        option interface 'cellular'
        option metric '1'
        option weight '8'

config member 'lb_wan2'
        option interface 'wan2'
        option metric '1'
        option weight '1'

config policy 'cell_backup'
        list use_member 'wan_m1_w3'
        list use_member 'wan2_m2_w2'
        list use_member 'cellular_m3_w1'
        option last_resort 'unreachable'

config policy 'load_b'
        list use_member 'lb_wan'
        list use_member 'lb_cell'
        list use_member 'lb_wan2'
        option last_resort 'unreachable'
