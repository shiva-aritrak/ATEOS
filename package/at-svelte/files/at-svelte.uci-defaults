#!/bin/sh

# Serve the at-svelte UI on 80/443 and move LuCI (uhttpd 'main') to 90/91.
# LuCI needs its own HTTPS port: its login page redirects to the HTTPS ports
# of uhttpd.main, which must not point at the at-svelte instance.
# Runs once per flash/sysupgrade; an existing at_svelte section is left as is
# so ports customised on the device survive upgrades.

uci -q get uhttpd.at_svelte >/dev/null && exit 0

uci -q batch <<-EOF
	delete uhttpd.main.listen_http
	delete uhttpd.main.listen_https
	add_list uhttpd.main.listen_http='0.0.0.0:90'
	add_list uhttpd.main.listen_http='[::]:90'
	add_list uhttpd.main.listen_https='0.0.0.0:91'
	add_list uhttpd.main.listen_https='[::]:91'

	set uhttpd.at_svelte=uhttpd
	add_list uhttpd.at_svelte.listen_http='0.0.0.0:80'
	add_list uhttpd.at_svelte.listen_http='[::]:80'
	add_list uhttpd.at_svelte.listen_https='0.0.0.0:443'
	add_list uhttpd.at_svelte.listen_https='[::]:443'
	set uhttpd.at_svelte.redirect_https='0'
	set uhttpd.at_svelte.home='/www-at'
	set uhttpd.at_svelte.index_page='index.html'
	set uhttpd.at_svelte.no_dirlists='1'
	set uhttpd.at_svelte.rfc1918_filter='1'
	set uhttpd.at_svelte.max_requests='3'
	set uhttpd.at_svelte.max_connections='100'
	set uhttpd.at_svelte.cert='/etc/uhttpd.crt'
	set uhttpd.at_svelte.key='/etc/uhttpd.key'
	set uhttpd.at_svelte.cgi_prefix='/cgi-bin'
	set uhttpd.at_svelte.ubus_prefix='/ubus'
	set uhttpd.at_svelte.ubus_socket='/var/run/ubus/ubus.sock'
	set uhttpd.at_svelte.script_timeout='60'
	set uhttpd.at_svelte.network_timeout='30'
	set uhttpd.at_svelte.http_keepalive='20'
	set uhttpd.at_svelte.tcp_keepalive='1'
	commit uhttpd
EOF

exit 0
